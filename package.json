{
  "name": "share_via_device",
  "version": "1.0.0",
  "description": "Create fresh public links for selected Nextcloud files and folders and hand them to the device share sheet.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src tests vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  },
  "dependencies": {
    "@mdi/svg": "^7.4.47",
