{
  "name": "lee-soda/share-via-device",
  "description": "Share selected Nextcloud files and folders through the device share sheet.",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Lee Soda",
      "email": "dhflyfree03@naver.com"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.80",
    "nextcloud/ocp": "^35.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "OCA\\ShareViaDevice\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\ShareViaDevice\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
